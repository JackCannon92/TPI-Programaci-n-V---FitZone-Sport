{
  "openapi": "3.0.0",
  "info": {
    "title": "API FitZone Sports",
    "version": "1.0.0",
    "description": "Documentación interactiva del Trabajo Integrador (Módulo 1)"
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Servidor Local"
    }
  ],
  "paths": {
    "/api/acceso/aforo/{sedeId}": {
      "get": {
        "summary": "Consulta la cantidad de personas adentro y los cupos disponibles (RF-05)",
        "tags": [
          "Acceso"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "sedeId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Cálculo de aforo en tiempo real obtenido"
          }
        }
      }
    },
    "/api/acceso/clave-publica": {
      "get": {
        "summary": "Clave pública que se instala en los tornos para validar el QR sin conexión (QR 2)",
        "tags": [
          "Acceso"
        ],
        "responses": {
          "200": {
            "description": "Clave pública Ed25519 en formato PEM"
          }
        }
      }
    },
    "/api/acceso/egreso": {
      "post": {
        "summary": "Registra la salida de un usuario liberando el aforo (RF-05)",
        "tags": [
          "Acceso"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "usuarioId",
                  "sedeId"
                ],
                "properties": {
                  "usuarioId": {
                    "type": "string",
                    "description": "UUID del usuario que sale"
                  },
                  "sedeId": {
                    "type": "string",
                    "description": "UUID de la sede"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Egreso registrado correctamente"
          },
          "404": {
            "description": "El usuario no figura adentro de esta sede"
          }
        }
      }
    },
    "/api/acceso/ingreso": {
      "post": {
        "summary": "Registra el ingreso validando token, membresía y aforo (RF-04, RF-05, RN-01)",
        "tags": [
          "Acceso"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "token": {
                    "type": "string",
                    "description": "Token extraído del endpoint generador de QR"
                  },
                  "sedeId": {
                    "type": "string",
                    "description": "UUID de la sede a la que intenta ingresar"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Ingreso registrado exitosamente"
          },
          "401": {
            "description": "QR inválido o vencido"
          },
          "403": {
            "description": "Membresía vencida"
          },
          "409": {
            "description": "Aforo completo o el usuario ya figura adentro de otra sede"
          }
        }
      }
    },
    "/api/acceso/ingreso-reserva": {
      "post": {
        "summary": "Ingreso a la sede con el QR de una reserva de cancha (QR 1 — ADR-016)",
        "description": "Para quien alquiló una cancha, sobre todo el cliente externo, que no tiene membresía. Valida la firma, el horario (desde 30 minutos antes del turno), la sede y que la reserva siga confirmada. Aplica RN-01 y el aforo.\n",
        "tags": [
          "Acceso"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "token": {
                    "type": "string",
                    "description": "Token que devuelve GET /api/canchas/reservas/{id}/qr"
                  },
                  "sedeId": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Ingreso registrado"
          },
          "401": {
            "description": "QR inválido, todavía no vigente o vencido"
          },
          "403": {
            "description": "La reserva es de otra sede"
          },
          "409": {
            "description": "Reserva cancelada, RN-01 o aforo completo"
          }
        }
      }
    },
    "/api/acceso/qr-offline/{usuarioId}": {
      "get": {
        "summary": "QR de acceso sin conexión para un socio activo (QR 2 — ADR-016)",
        "description": "Firmado con Ed25519 y válido por 24 horas (o hasta que vence la membresía). El torno lo valida sin internet, solo con la clave pública.\n",
        "tags": [
          "Acceso"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "usuarioId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Token, validez e imagen SVG"
          },
          "403": {
            "description": "El usuario no es un socio con la membresía activa"
          }
        }
      }
    },
    "/api/acceso/qr/{usuarioId}": {
      "get": {
        "summary": "Genera el token QR dinámico para un socio (RF-04)",
        "tags": [
          "Acceso"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "usuarioId",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "UUID del usuario"
          }
        ],
        "responses": {
          "200": {
            "description": "Token generado exitosamente (vigente por 1 minuto)"
          }
        }
      }
    },
    "/api/acceso/sincronizar": {
      "post": {
        "summary": "El terminal de sede manda los ingresos que registró sin conexión (ADR-007)",
        "description": "Cada ingreso trae el QR sin conexión que se leyó y la hora en que la persona pasó. El servidor vuelve a verificar la firma con esa hora, descarta los reenvíos (misma persona, sede y hora) y resuelve RN-01 a favor de lo que pasó físicamente: si figuraba adentro sin egreso, ese registro se cierra a la hora del ingreso nuevo. El aforo no frena la sincronización (esas personas ya entraron).\n",
        "tags": [
          "Acceso"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "sedeId",
                  "ingresos"
                ],
                "properties": {
                  "sedeId": {
                    "type": "string",
                    "description": "UUID de la sede del terminal"
                  },
                  "ingresos": {
                    "type": "array",
                    "maxItems": 200,
                    "items": {
                      "type": "object",
                      "required": [
                        "id",
                        "token",
                        "fechaIngreso"
                      ],
                      "properties": {
                        "id": {
                          "type": "string",
                          "description": "Identificador del evento que generó el terminal"
                        },
                        "token": {
                          "type": "string",
                          "description": "QR sin conexión leído"
                        },
                        "fechaIngreso": {
                          "type": "string",
                          "format": "date-time",
                          "description": "Hora en que la persona pasó (reloj del terminal)"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "{ resumen: { aceptados, duplicados, rechazados, conflictos }, aforo, resultados: [{ id, estado, motivo?, conflicto? }] }"
          },
          "400": {
            "description": "Datos mal formados"
          },
          "404": {
            "description": "La sede no existe"
          }
        }
      }
    },
    "/api/acceso/validar-offline": {
      "post": {
        "summary": "Valida un QR sin conexión como lo haría el torno, sin consultar la base (QR 2)",
        "tags": [
          "Acceso"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "token": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "{ valido: true, usuarioId, nombre, venceMembresia } o { valido: false, motivo }"
          }
        }
      }
    },
    "/api/canchas": {
      "post": {
        "summary": "Alta de canchas por sede con costo y tipo (RF-09)",
        "tags": [
          "Canchas"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "sedeId",
                  "nombre",
                  "tipo",
                  "precioHora"
                ],
                "properties": {
                  "sedeId": {
                    "type": "string"
                  },
                  "nombre": {
                    "type": "string"
                  },
                  "tipo": {
                    "type": "string",
                    "enum": [
                      "FUTBOL",
                      "PADEL",
                      "TENIS",
                      "BASQUET"
                    ]
                  },
                  "precioHora": {
                    "type": "number"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Cancha creada exitosamente"
          }
        }
      }
    },
    "/api/canchas/{id}/disponibilidad": {
      "get": {
        "summary": "Devuelve la grilla horaria de turnos disponibles y ocupados (RF-10)",
        "tags": [
          "Canchas"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "fecha",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date",
              "example": "2026-10-15"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de slots horarios con bandera indicando si están libres o son hora pico"
          }
        }
      }
    },
    "/api/canchas/{id}/estado": {
      "patch": {
        "summary": "Inhabilita la cancha por mantenimiento bloqueando reservas futuras (RF-12)",
        "tags": [
          "Canchas"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "description": "UUID de la cancha",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "estado": {
                    "type": "string",
                    "enum": [
                      "DISPONIBLE",
                      "MANTENIMIENTO",
                      "INACTIVA"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Estado actualizado exitosamente"
          }
        }
      }
    },
    "/api/canchas/{id}/precio": {
      "get": {
        "summary": "Cotiza el valor de una reserva (Precio base fijo por hora)",
        "tags": [
          "Canchas"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "usuarioId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "inicio",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time",
              "example": "2026-10-15T19:00:00Z"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Precio base de la cancha calculado exitosamente"
          }
        }
      }
    },
    "/api/canchas/reservas": {
      "post": {
        "summary": "Reserva un turno resolviendo la concurrencia en BD (RN-02)",
        "tags": [
          "Canchas"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "canchaId",
                  "usuarioId",
                  "fechaHoraInicio"
                ],
                "properties": {
                  "canchaId": {
                    "type": "string"
                  },
                  "usuarioId": {
                    "type": "string"
                  },
                  "fechaHoraInicio": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Reserva creada con éxito"
          },
          "409": {
            "description": "Conflicto - La cancha está en mantenimiento o el turno acaba de ser tomado por otro usuario"
          }
        }
      }
    },
    "/api/canchas/reservas/{id}/qr": {
      "get": {
        "summary": "QR de ingreso de una reserva de cancha paga (QR 1 — ADR-016)",
        "description": "Lo usa quien alquiló la cancha para entrar a la sede, sobre todo el cliente externo, que no tiene QR de socio. Vale desde 30 minutos antes del turno hasta que termina, y solo en la sede de esa cancha.\n",
        "tags": [
          "Canchas"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "UUID de la reserva"
          }
        ],
        "responses": {
          "200": {
            "description": "Token del QR, ventana de validez e imagen SVG"
          },
          "409": {
            "description": "La reserva todavía no está paga"
          }
        }
      }
    },
    "/api/canchas/sede/{sedeId}": {
      "get": {
        "summary": "Lista todas las canchas de una sucursal específica",
        "tags": [
          "Canchas"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "sedeId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Arreglo de canchas disponibles en la sede"
          }
        }
      }
    },
    "/api/clases": {
      "post": {
        "summary": "Crea una nueva clase grupal con capacidad máxima (RF-06)",
        "tags": [
          "Clases"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "sedeId",
                  "tipo",
                  "instructor",
                  "fechaHora",
                  "capacidadMaxima"
                ],
                "properties": {
                  "sedeId": {
                    "type": "string"
                  },
                  "tipo": {
                    "type": "string",
                    "example": "Spinning"
                  },
                  "instructor": {
                    "type": "string"
                  },
                  "fechaHora": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "capacidadMaxima": {
                    "type": "integer",
                    "example": 20
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Clase creada exitosamente"
          }
        }
      },
      "get": {
        "summary": "Lista las clases programadas (permite filtrar por sede)",
        "tags": [
          "Clases"
        ],
        "parameters": [
          {
            "in": "query",
            "name": "sedeId",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Arreglo de clases disponibles"
          }
        }
      }
    },
    "/api/clases/{id}": {
      "get": {
        "summary": "Obtiene los detalles de una clase específica",
        "tags": [
          "Clases"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Datos de la clase"
          }
        }
      }
    },
    "/api/clases/{id}/lista-espera": {
      "get": {
        "summary": "Muestra los usuarios anotados en la lista de espera",
        "tags": [
          "Clases"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de espera actual"
          }
        }
      }
    },
    "/api/clases/asistencia": {
      "post": {
        "summary": "Marca la asistencia escaneando el QR (la reserva pasa a ASISTIO) (QR 3)",
        "tags": [
          "Clases"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "token": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Reserva con estado ASISTIO"
          },
          "401": {
            "description": "QR inválido o fuera del horario de la clase"
          },
          "409": {
            "description": "La asistencia ya estaba registrada o la reserva fue cancelada"
          }
        }
      }
    },
    "/api/clases/lista-espera": {
      "post": {
        "summary": "Anota a un usuario en la lista de espera cuando la clase está llena (RF-08)",
        "tags": [
          "Clases"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "claseId",
                  "usuarioId"
                ],
                "properties": {
                  "claseId": {
                    "type": "string"
                  },
                  "usuarioId": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Usuario agregado a la cola de espera"
          }
        }
      }
    },
    "/api/clases/reservas": {
      "post": {
        "summary": "Reserva un cupo y lo decrementa de la clase (RF-07)",
        "tags": [
          "Clases"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "claseId",
                  "usuarioId"
                ],
                "properties": {
                  "claseId": {
                    "type": "string"
                  },
                  "usuarioId": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Reserva confirmada"
          },
          "400": {
            "description": "La clase no tiene cupos disponibles"
          }
        }
      }
    },
    "/api/clases/reservas/{id}/cancelar": {
      "patch": {
        "summary": "Cancela una reserva y aplica penalidad si es con menos de 2hs de aviso (RF-07)",
        "tags": [
          "Clases"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Reserva cancelada exitosamente y cupo liberado"
          }
        }
      }
    },
    "/api/clases/reservas/{id}/qr": {
      "get": {
        "summary": "QR de asistencia de una reserva de clase confirmada (QR 3 — ADR-016)",
        "description": "Vale desde 30 minutos antes de la clase hasta 60 minutos después de que empezó.",
        "tags": [
          "Clases"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "UUID de la reserva de clase"
          }
        ],
        "responses": {
          "200": {
            "description": "Token, ventana de validez e imagen SVG"
          },
          "409": {
            "description": "La reserva no está confirmada"
          }
        }
      }
    },
    "/api/clases/reservas/usuario/{usuarioId}": {
      "get": {
        "summary": "Lista todas las reservas de clases realizadas por un usuario",
        "tags": [
          "Clases"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "usuarioId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Historial de clases del usuario"
          }
        }
      }
    },
    "/api/membresias/{id_usuario}": {
      "get": {
        "summary": "Obtiene el estado actual de la membresía de un usuario (RF-02)",
        "tags": [
          "Membresías"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id_usuario",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "UUID del usuario"
          }
        ],
        "responses": {
          "200": {
            "description": "Estado de la membresía obtenido con éxito"
          },
          "404": {
            "description": "Membresía no encontrada"
          }
        }
      }
    },
    "/api/membresias/{id_usuario}/renovar": {
      "put": {
        "summary": "Renueva el plan de membresía de un socio (RF-02)",
        "tags": [
          "Membresías"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id_usuario",
            "required": true,
            "schema": {
              "type": "string",
              "description": "UUID del usuario"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "plan"
                ],
                "properties": {
                  "plan": {
                    "type": "string",
                    "enum": [
                      "MENSUAL",
                      "TRIMESTRAL",
                      "ANUAL"
                    ],
                    "example": "ANUAL"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Membresía renovada con éxito"
          }
        }
      }
    },
    "/api/membresias/{id_usuario}/suspender": {

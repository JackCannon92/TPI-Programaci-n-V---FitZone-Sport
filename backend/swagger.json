    "/api/usuarios": {
      "post": {
        "summary": "Registra un nuevo usuario en el sistema (RF-01)",
        "tags": [
          "Usuarios"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "usuario"
                ],
                "properties": {
                  "usuario": {
                    "type": "object",
                    "required": [
                      "dni",
                      "nombre_completo",
                      "email",
                      "tipo"
                    ],
                    "properties": {
                      "dni": {
                        "type": "string",
                        "example": "35123456"
                      },
                      "nombre_completo": {
                        "type": "string",
                        "example": "Juan Pérez"
                      },
                      "email": {
                        "type": "string",
                        "format": "email",
                        "example": "juan@email.com"
                      },
                      "telefono": {
                        "type": "string",
                        "example": "3454123456"
                      },
                      "foto_url": {
                        "type": "string",
                        "example": "https://ejemplo.com/foto.jpg"
                      },
                      "tipo": {
                        "type": "string",
                        "enum": [
                          "SOCIO",
                          "CLIENTE_EXTERNO"
                        ],
                        "example": "SOCIO"
                      },
                      "rol": {
                        "type": "string",
                        "enum": [
                          "CLIENTE",
                          "RECEPCIONISTA",
                          "GERENTE"
                        ],
                        "example": "CLIENTE"
                      }
                    }
                  },
                  "membresia": {
                    "type": "object",
                    "properties": {
                      "plan": {
                        "type": "string",
                        "example": "MENSUAL"
                      },
                      "fecha_inicio": {
                        "type": "string",
                        "format": "date",
                        "example": "2026-09-27"
                      },
                      "fecha_vencimiento": {
                        "type": "string",
                        "format": "date",
                        "example": "2026-10-27"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Usuario creado exitosamente"
          },
          "400": {
            "description": "Datos inválidos o incongruencia entre usuario y membresía"
          },
          "409": {
            "description": "Conflicto - El DNI o Email ya existe"
          },
          "500": {
            "description": "Error interno del servidor"
          }
        }
      },

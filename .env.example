# Variables del docker-compose. Copiar como .env (en esta misma carpeta) y cambiar los valores.
# El .env NO se sube al repositorio. Para correr el backend sin Docker, ver Backend/.env.example.

# Contraseña del PostgreSQL que levanta el docker-compose
POSTGRES_PASSWORD=cambiar-por-una-clave

# Clave para firmar los QR (ADR-016). Cualquier texto largo y secreto.
QR_SECRET=cambiar-por-una-clave-larga-y-secreta

# Dirección pública de la API: va impresa en el QR de verificación del comprobante.
URL_PUBLICA=http://localhost:3000

# Copiar este archivo como .env y completar los valores. El .env NO se sube al repositorio.

# Puerto donde levanta la API
PORT=3000

# Cadena de conexión de Supabase (Project Settings → Database → Connection string → URI, modo "Session pooler").
# Reemplazar [YOUR-PASSWORD] por la contraseña de la base (no es la de la cuenta de Supabase).
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-us-east-2.pooler.supabase.com:6543/postgres

# Clave para firmar los QR de acceso (RF-04). Usar cualquier texto largo y secreto.
QR_SECRET=cambiar-por-una-clave-larga-y-secreta

# Dirección pública de la API: va impresa en el QR de verificación del comprobante (ADR-010).
# En local queda http://localhost:3000; cuando se publique, poner la URL real.
URL_PUBLICA=http://localhost:3000

# (Opcional) Semilla de la clave del QR de acceso sin conexión (ADR-010).
# Si no se define, se deriva de QR_SECRET. Si se cambia, los QR sin conexión ya emitidos dejan de valer.
# QR_OFFLINE_SEMILLA=otra-clave-larga-y-secreta

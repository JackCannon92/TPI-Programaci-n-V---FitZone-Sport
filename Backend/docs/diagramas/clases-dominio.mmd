  %% Strategy (ADR-013)
  class Tarifador {
    -ReglaPrecio precioBase
    -ReglaPrecio[] reglas
    +cotizar(contexto) Cotizacion
  }
  class ReglaPrecio {
    <<interface>>
    +String nombre
    +aplica(contexto) bool
    +aplicar(precio) number
  }
  class PrecioEstandar
  class DescuentoSocio
  class RecargoHorarioPico
  Tarifador o-- "1..*" ReglaPrecio : estrategias
  ReglaPrecio <|.. PrecioEstandar
  ReglaPrecio <|.. DescuentoSocio
  ReglaPrecio <|.. RecargoHorarioPico
  Tarifador ..> ReservaCancha : calcula precioFinal y detallePrecio

  %% Repository (ADR-014)
  class RepositorioReservas {
    <<interface>>
    +registrar(datos) ReservaCancha
    +porId(id) ReservaCancha
    +deUsuario(usuarioId) ReservaCancha[]
    +turnosOcupados(canchaId, desde, hasta)
    +cambiarEstado(id, estado)
  }
  class ReservasSequelize
  class ReservasMemoria
  RepositorioReservas <|.. ReservasSequelize
  RepositorioReservas <|.. ReservasMemoria
  RepositorioReservas ..> ReservaCancha : persiste

  %% Observer (ADR-015)
  class BusEventos {
    +suscribir(evento, oyente)
    +publicar(evento, datos)
  }
  class OyenteCupoLiberado {
    <<interface>>
    +alLiberarseCupo(evento)
  }
  class AvisoListaEspera
  class ServicioClases {
    +cancelarReserva(id)
  }
  BusEventos o-- "*" OyenteCupoLiberado : oyentes
  OyenteCupoLiberado <|.. AvisoListaEspera
  ServicioClases ..> BusEventos : publica CupoLiberado
  AvisoListaEspera ..> ListaEspera : marca notificado

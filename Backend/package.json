{
  "name": "fitzone-sports-backend",
  "version": "1.0.0",
  "description": "Backend del Trabajo Integrador FitZone Sports (Programación V, FCAD-UNER)",
  "private": true,
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-validator": "^7.3.2",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0",
    "pg-hstore": "^2.3.4",
    "qrcode": "^1.5.4",
    "sequelize": "^6.37.8",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/test/unit/**/*.test.js",
      "<rootDir>/test/integracion/**/*.test.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/_respaldo_original_franco/"
    ]
  }
}
